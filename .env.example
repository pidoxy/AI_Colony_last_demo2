# Upstash/Vercel Marketplace Redis. Without these, local development uses memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel's Upstash integration may provide these equivalent names instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Kill switch and hard daily cap. 0 disables all model calls without a redeploy.
BOT_ENABLED=0
BOT_DAILY_CAP=30
BOT_MODEL_ENDPOINT=
BOT_MODEL_NAME=
BOT_MODEL_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
